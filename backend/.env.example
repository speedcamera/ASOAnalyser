DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/seoanalyser
PORT=3001

# Clerk backend authentication (P5A).
# Clerk Dashboard → API keys. Copy the publishable key and the secret key.
# Never commit real keys. Never put CLERK_SECRET_KEY in frontend env or responses.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# P5B Development Organisation bootstrap.
# Set this to the Clerk user id (user_...) of the existing developer/operator
# who should join the existing Development Organisation as owner.
# Leave it unset until that identity is known. Do not set it to the P5A test
# user, an email address, or a local users.id. New users who are not this
# exact Clerk id receive their own empty organisation.
# NODE_ENV=production disables this bootstrap even if the variable is set.
# Do not set it in the production environment.
# DEVELOPMENT_ORGANISATION_BOOTSTRAP_CLERK_USER_ID=user_replace_me
#
# Production process values belong in the protected production env file,
# not in Git. Names only:
# NODE_ENV=production
# PORT=3002
# DATABASE_URL=postgresql://seoanalyser_prod:PASSWORD@localhost:5432/seoanalyser_production
# FRONTEND_ORIGIN=https://<production-hostname>
# CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY are the live pair, added in a later phase.
# Do not invent a hostname or live Clerk keys here.

# Browser origin of the frontend. Used by CORS.
# Development allows http://localhost:5173 even when this is unset.
# NODE_ENV=production requires an explicit origin and does not assume localhost.
# Separate more than one origin with commas. Do not use a wildcard.
# FRONTEND_ORIGIN=https://app.example.com

# CSV upload limits (P6A.2). Blank values use these defaults.
# The largest stored Apple Ads import is about 12.7 MB and 60,005 rows, so the
# file default is 16 MB rather than 10 MB. Whole numbers only.
# MAX_CSV_FILE_SIZE_MB is 1-32. MAX_CSV_ROWS is 1-200000.
# MAX_CSV_UPLOADS_PER_WINDOW is 1-60. MAX_CSV_UPLOAD_WINDOW_MINUTES is 1-1440.
# MAX_CSV_FILE_SIZE_MB=16
# MAX_CSV_ROWS=100000
# MAX_CSV_UPLOADS_PER_WINDOW=10
# MAX_CSV_UPLOAD_WINDOW_MINUTES=15
